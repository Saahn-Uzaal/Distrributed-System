# DS03 — env mẫu. Copy thành .env trước khi chạy compose:
#   cp .env.example .env
# Giá trị dưới đây là dev-only; KHÔNG dùng cho production.

# PostgreSQL admin (init/debug only — không phải tài khoản của service nào)
POSTGRES_ADMIN_USER=postgres_admin
POSTGRES_ADMIN_PASSWORD=pg_admin_dev_2026
POSTGRES_PORT=5432

# Tài khoản riêng của từng service (mỗi user chỉ truy cập DB của mình)
IDENTITY_DB_PASSWORD=identity_dev_2026
DRIVER_DB_PASSWORD=driver_dev_2026
TRIP_DB_PASSWORD=trip_dev_2026
MATCHING_DB_PASSWORD=matching_dev_2026
PAYMENT_DB_PASSWORD=payment_dev_2026

# RabbitMQ (T04) — dev-only, KHÔNG dùng cho production
RABBITMQ_USER=ridehailing_dev
RABBITMQ_PASSWORD=rabbit_dev_2026
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# JWT (T06) — keys sinh bởi scripts/generate-dev-keys.sh vào keys/ (gitignored, *.pem)
# driver-service/trip-service verify token bằng public key này (env tiến trình Java local).
JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem
JWT_EXPIRES_IN_SECONDS=3600

# Internal API credential (T07) — dev token dùng chung cho header X-Internal-Token
# (contract api-contracts.md §1/§4). Chỉ service chạy local cần env này; KHÔNG expose qua Nginx.
INTERNAL_API_TOKEN=internal_dev_2026

# Fare trip-service (T12) — contract api-contracts.md §3.3: fareVnd = FARE_BASE_VND + ceil(distanceM/1000)*FARE_PER_KM_VND
FARE_BASE_VND=12000
FARE_PER_KM_VND=5000

# Public map services for local/demo traffic only. Nominatim searches are explicit (no autocomplete).
MAP_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
MAP_OSRM_BASE_URL=https://router.project-osrm.org
MAP_USER_AGENT=DS03-RideHailing/0.1 (local-demo)
MAP_HTTP_TIMEOUT_MS=4000
MAP_OSRM_TIMEOUT_MS=5000
MAP_LOCATION_TOKEN_TTL_SECONDS=900
MAP_QUOTE_TTL_SECONDS=600

# Driver RESERVED expiry (T11); worker never expires CONFIRMED assignments.
RESERVATION_EXPIRY_ENABLED=true
RESERVATION_EXPIRY_FIXED_DELAY_MS=1000

# Matching deadline tổng (T21) và tỷ lệ decline giả lập của payment (T23; 0..1, 1 = luôn FAILED).
TRIP_MATCH_DEADLINE_SECONDS=120
PAYMENT_SIMULATE_FAIL_RATE=0

# Container identity-service đọc private key mode 600 của user host. Windows/macOS Docker Desktop không cần;
# Linux bỏ comment và đặt theo `id -u` / `id -g`.
# HOST_UID=1000
# HOST_GID=1000

# Seed demo users (dùng sau bởi scripts/seed-demo.sh ở T26) — dev-only
SEED_PASSWORD=SeedPass123!
