# DS03 — T29: frontend image. Build Vite (tsc --noEmit && vite build) -> nginx serve dist.
# Proxy conf deploy/nginx.conf BAKE vào image (proxy_pass sang DNS tên service compose) —
# thay bind-mount ../src/web/dist + host.docker.internal của chế độ dev cũ.
FROM node:24.18.0-alpine AS builder
WORKDIR /web
COPY src/web/package.json src/web/package-lock.json ./
RUN npm ci
COPY src/web/index.html src/web/vite.config.ts src/web/tsconfig.json ./
COPY src/web/src/ ./src/
RUN npm run build

# F32: pin patch version đầy đủ (bản thực tế của tag 1.27)
FROM nginx:1.27.5-alpine
COPY deploy/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /web/dist /usr/share/nginx/html
