    <module>src/driver-service</module>
    <module>src/trip-service</module>
    <module>src/matching-service</module>
    <module>src/payment-service</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <!-- Boot 4 BOM không quản lý Testcontainers/Nimbus — pin explicit (stable, verified 2026-10-19) -->
    <testcontainers.version>1.21.4</testcontainers.version>
    <nimbus-jose-jwt.version>10.10</nimbus-jose-jwt.version>
  </properties>
</project>
